# Porta usada pelos outros dispositivos da rede.
QABASE_PORT=8080

# Em uma rede local usando HTTP, mantenha false.
# Altere para true somente depois de configurar HTTPS.
QABASE_SECURE_COOKIES=false
QABASE_TRUST_PROXY=false

# Token criado no BotFather. Nunca versionar o arquivo deploy/.env.
TELEGRAM_BOT_TOKEN=

# Quantidade de dias mantida pelo script de backup.
QABASE_BACKUP_RETENTION_DAYS=30
